{
  "name": "arena-animated-shorts",
  "version": "0.1.0",
  "private": true,
  "description": "A local Remotion production workspace for original animated shorts",
  "scripts": {
    "studio": "remotion studio src/index.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "still": "node scripts/render-still.mjs",
    "py": "node scripts/python.mjs",
    "render": "node scripts/render-video.mjs",
    "ffmpeg": "node scripts/media.mjs ffmpeg",
    "ffprobe": "node scripts/media.mjs ffprobe",
    "test": "node --test tests/*.test.mjs",
    "preview:video": "node scripts/serve-video.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/three": "4.0.543",
    "postprocessing": "6.37.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.543",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@sparticuz/chromium": "133.0.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/three": "0.175.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
